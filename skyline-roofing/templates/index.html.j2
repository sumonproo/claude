<!doctype html>
<html lang="en-US">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Roofing Contractor in {{ place }} | Roof Replacement &amp; Repair | {{ biz.short_name }}</title>
  <meta name="description" content="{{ biz.name }} replaces and repairs roofs in {{ place }}{% if areas %} and nearby {{ areas[:3]|join(', ') }}{% endif %}. Storm damage, inspections and new roofs. Call {{ phone }}.">
  {% if site_url %}<link rel="canonical" href="{{ site_url }}">{% endif %}
  <meta name="geo.region" content="US-{{ state_abbr }}">
  <meta name="geo.placename" content="{{ city }}">
  {% if loc.latitude and loc.longitude %}<meta name="geo.position" content="{{ loc.latitude }};{{ loc.longitude }}">{% endif %}
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#0e1726">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Roofing Contractor in {{ place }} | {{ biz.short_name }}">
  <meta property="og:description" content="Roof replacement, repair and storm damage work in {{ place }}.">
  {% if site_url %}<meta property="og:url" content="{{ site_url }}">{% endif %}
  {% if site_url and exists("assets/img/og.jpg") %}<meta property="og:image" content="{{ site_url }}assets/img/og.jpg">{% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preload" href="assets/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="assets/icons/phosphor.css">
  <link rel="stylesheet" href="styles.css">
  {% if exists(biz.logo) %}<link rel="icon" href="{{ biz.logo }}">{% endif %}
  <script type="application/ld+json">
{{ org_json|safe }}
  </script>
  <script type="application/ld+json">
{{ faq_json|safe }}
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="header">
    <div class="container header-inner">
      <a class="brand" href="#top" aria-label="{{ biz.short_name }} home">
        {% if exists(biz.logo) %}<img class="brand-logo" src="{{ biz.logo }}" alt="" width="44" height="44" >{% endif %}
        <span class="brand-name">{{ biz.short_name.split(" ", 1)[0] }}{% if " " in biz.short_name %}<span> {{ biz.short_name.split(" ", 1)[1] }}</span>{% endif %}</span>
      </a>
      <nav aria-label="Primary">
        <ul class="nav-links">
          <li><a href="#services">Services</a></li>
          <li><a href="#process">Process</a></li>
          <li><a href="#storm">Storm damage</a></li>
          <li><a href="#areas">Areas</a></li>
          <li><a href="#faq">FAQ</a></li>
        </ul>
      </nav>
      <div class="header-actions">
        <a class="phone-link" href="{{ tel }}"><i class="ph ph-phone" aria-hidden="true"></i><span>{{ phone }}</span></a>
        <a class="btn btn-accent btn-sm" href="#estimate">Get an estimate</a>
      </div>
    </div>
  </header>

  <main id="main">
    <!-- Hero with lead form -->
    <section class="hero" id="top">
      <div class="hero-sky" aria-hidden="true">
        {% if exists("assets/video/hero.mp4") %}
        <video class="hero-media" id="hero-video" muted loop playsinline preload="none"{% if exists("assets/img/hero.jpg") %} poster="assets/img/hero.jpg"{% endif %}>
          {% if exists("assets/video/hero.webm") %}<source src="assets/video/hero.webm" type="video/webm">{% endif %}
          <source src="assets/video/hero.mp4" type="video/mp4">
        </video>
        {% elif exists("assets/img/hero.jpg") %}
        <img class="hero-media" src="assets/img/hero.jpg" alt="" fetchpriority="high">
        {% endif %}
      </div>
      {% if exists("assets/video/hero.mp4") or exists("assets/img/hero.jpg") %}<div class="hero-shade" aria-hidden="true"></div>{% endif %}
      <div class="hero-ridge" aria-hidden="true"></div>
      {% if exists("assets/video/hero.mp4") %}
      <button class="video-toggle" type="button" id="video-toggle" aria-pressed="false" hidden>
        <i class="ph ph-pause" aria-hidden="true"></i><span>Pause video</span>
      </button>
      {% endif %}
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow load" style="--i:0"><i class="ph ph-map-pin" aria-hidden="true"></i>Roofing contractor in {{ place }}</p>
          <h1 class="load" style="--i:1">Roof replacement and repair in {{ city }}, {{ state_abbr }}</h1>
          <p class="lede load" style="--i:2">New roofs, leak repairs and storm damage work for homeowners in {{ city }} and nearby towns.</p>
          <div class="hero-ctas load" style="--i:3">
            <a class="btn btn-accent" href="#estimate">Get an estimate<i class="ph ph-arrow-right" aria-hidden="true"></i></a>
            <a class="btn btn-outline-light" href="{{ tel }}"><i class="ph ph-phone" aria-hidden="true"></i>Call {{ phone }}</a>
          </div>
        </div>

        <div class="form-card load" style="--i:2" id="estimate">
          <h2>Get an estimate</h2>
          <p class="form-sub">Tell us about the roof. We will call to set up a time to look at it.</p>
          <form id="lead-form" novalidate>
            <div class="field">
              <label for="f-name">Name</label>
              <input id="f-name" name="name" type="text" autocomplete="name" required aria-describedby="e-name">
              <p class="error" id="e-name" role="alert"></p>
            </div>
            <div class="field">
              <label for="f-phone">Phone</label>
              <input id="f-phone" name="phone" type="tel" autocomplete="tel" required aria-describedby="e-phone">
              <p class="error" id="e-phone" role="alert"></p>
            </div>
            <div class="field">
              <label for="f-address">Property address or ZIP</label>
              <input id="f-address" name="address" type="text" autocomplete="street-address" required aria-describedby="e-address">
              <p class="error" id="e-address" role="alert"></p>
            </div>
            <div class="field">
              <label for="f-service">What do you need?</label>
              <div class="select">
                <select id="f-service" name="service">
                  {% for s in cfg.services %}<option>{{ s.name }}</option>{% endfor %}
                  <option>Not sure yet</option>
                </select>
                <i class="ph ph-caret-down" aria-hidden="true"></i>
              </div>
            </div>
            <button class="btn btn-accent btn-block" type="submit">Get an estimate<i class="ph ph-arrow-right" aria-hidden="true"></i></button>
            <p class="form-note">We only use your details to contact you about this request.</p>
          </form>
          <div class="form-success" id="form-success" hidden tabindex="-1">
            <i class="ph ph-check-circle" aria-hidden="true"></i>
            <h3>Request received</h3>
            <p id="success-text">Thanks. We will be in touch shortly to schedule a time.</p>
          </div>
        </div>
      </div>
    </section>

    {% set trust = [] %}
    {% if biz.license_number %}{% set _ = trust.append(('shield-check', 'Licensed, #' ~ biz.license_number)) %}{% endif %}
    {% if offers.manufacturer_certification %}{% set _ = trust.append(('seal-check', offers.manufacturer_certification)) %}{% endif %}
    {% if offers.workmanship_warranty_years %}{% set _ = trust.append(('certificate', offers.workmanship_warranty_years ~ '-year workmanship warranty')) %}{% endif %}
    {% if offers.free_inspection %}{% set _ = trust.append(('magnifying-glass', 'Free roof inspections')) %}{% endif %}
    {% if offers.insurance_claim_help %}{% set _ = trust.append(('file-text', 'Insurance claim help')) %}{% endif %}
    {% if offers.financing %}{% set _ = trust.append(('credit-card', 'Financing available')) %}{% endif %}
    {% if offers.emergency_tarping %}{% set _ = trust.append(('umbrella', 'Emergency tarping')) %}{% endif %}
    {% if trust %}
    <section class="trust" aria-label="Why homeowners choose us">
      <ul class="container trust-list">
        {% for icon, label in trust %}<li><i class="ph ph-{{ icon }}" aria-hidden="true"></i>{{ label }}</li>{% endfor %}
      </ul>
    </section>
    {% endif %}

    <!-- Services -->
    <section class="section services" id="services">
      <div class="container">
        <h2 class="section-title reveal">Roofing services in {{ city }}</h2>
        <p class="section-sub reveal">From a single leak to a full tear-off, we handle the job from inspection to cleanup.</p>
        <div class="service-grid">
          {% for s in cfg.services %}
          <article class="service reveal{% if loop.first %} service-feature{% endif %}" style="--d:{{ loop.index0 }}">
            {% if loop.first or (s.image and exists(s.image)) %}
            <div class="service-photo photo">
              {% if s.image and exists(s.image) %}<img src="{{ s.image }}" alt="{{ s.alt }}" loading="lazy" width="1200" height="800">{% endif %}
            </div>
            {% endif %}
            <div class="service-body">
              <i class="ph ph-{{ s.icon }} service-icon" aria-hidden="true"></i>
              <h3>{{ s.name }}</h3>
              <p>{{ s.summary }}</p>
            </div>
          </article>
          {% endfor %}
        </div>
      </div>
    </section>

    <!-- Process -->
    <section class="section process" id="process">
      <div class="container">
        <h2 class="section-title reveal">How a roof project works</h2>
        <ol class="steps">
          <li class="step reveal" style="--d:0"><h3>Inspect</h3><p>We get on the roof, check the decking, flashing and vents, and take photos of what we find.</p></li>
          <li class="step reveal" style="--d:1"><h3>Estimate</h3><p>You get a written, itemized price and a clear scope. No work starts until you approve it.</p></li>
          <li class="step reveal" style="--d:2"><h3>Install</h3><p>We protect the yard and landscaping, tear off, repair decking as needed and install the new system.</p></li>
          <li class="step reveal" style="--d:3"><h3>Clean up</h3><p>Magnet sweep for nails, debris hauled away, and a final walkthrough with you.</p></li>
        </ol>
      </div>
    </section>

    <!-- Storm damage -->
    <section class="section storm" id="storm">
      <div class="container storm-grid">
        <div class="storm-photo photo reveal">
          {% if exists("assets/img/storm.jpg") %}<img src="assets/img/storm.jpg" alt="Roofer inspecting hail damage on asphalt shingles" loading="lazy" width="1200" height="1500">{% endif %}
        </div>
        <div class="storm-copy">
          <h2 class="section-title reveal">Storm damage in {{ city }}? Start here.</h2>
          <p class="section-sub reveal">Hail and high wind do damage you often cannot see from the ground. After a storm:</p>
          <ul class="checklist reveal">
            <li><i class="ph ph-check" aria-hidden="true"></i>Stay off the roof and photograph what you can see from the yard.</li>
            <li><i class="ph ph-check" aria-hidden="true"></i>Look for missing shingles, dented gutters and granules in the downspouts.</li>
            <li><i class="ph ph-check" aria-hidden="true"></i>Catch active leaks and move valuables away from them.</li>
            <li><i class="ph ph-check" aria-hidden="true"></i>{% if offers.insurance_claim_help %}Call us for an inspection. We document the damage for your insurance claim.{% else %}Call us for an inspection before you sign anything with a storm chaser.{% endif %}</li>
          </ul>
          <div class="reveal">
            <a class="btn btn-dark" href="{{ tel }}"><i class="ph ph-phone" aria-hidden="true"></i>Call {{ phone }}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Reviews -->
    <section class="section reviews" id="reviews">
      <div class="container">
        <h2 class="section-title reveal">What {{ city }} homeowners say</h2>
        {% if cfg.reviews['items'] %}
        <div class="review-grid">
          {% for r in cfg.reviews['items'] %}
          <figure class="review reveal" style="--d:{{ loop.index0 }}">
            <div class="stars" aria-label="{{ r.rating }} out of 5 stars">{% for _ in range(r.rating|int) %}<i class="ph ph-star" aria-hidden="true"></i>{% endfor %}</div>
            <blockquote>&ldquo;{{ r.text }}&rdquo;</blockquote>
            <figcaption>{{ r.name }}<span>{{ r.location }}</span></figcaption>
          </figure>
          {% endfor %}
        </div>
        {% else %}
        <div class="review-empty reveal">
          <i class="ph ph-star" aria-hidden="true"></i>
          <p>See photos of recent jobs and read what customers say on our profiles.</p>
          <div class="review-links">
            {% if loc.google_business_profile_url %}<a class="btn btn-dark" href="{{ loc.google_business_profile_url }}" target="_blank" rel="noopener"><i class="ph ph-google-logo" aria-hidden="true"></i>Google reviews</a>{% endif %}
            {% if cfg.social.facebook %}<a class="btn btn-outline" href="{{ cfg.social.facebook }}" target="_blank" rel="noopener"><i class="ph ph-facebook-logo" aria-hidden="true"></i>Facebook</a>{% endif %}
            {% if cfg.social.instagram %}<a class="btn btn-outline" href="{{ cfg.social.instagram }}" target="_blank" rel="noopener"><i class="ph ph-instagram-logo" aria-hidden="true"></i>Instagram</a>{% endif %}
          </div>
        </div>
        {% endif %}
      </div>
    </section>

    <!-- Service areas -->
    <section class="section areas" id="areas">
      <div class="container areas-grid">
        <div>
          <h2 class="section-title reveal">Roofing in {{ city }} and nearby</h2>
          <p class="section-sub reveal">{{ biz.short_name }} works on homes across {{ city }}{% if areas %} and the surrounding area, including {{ areas[:-1]|join(', ') }}{% if areas|length > 1 %} and {% endif %}{{ areas[-1] }}{% endif %}. Not sure if we cover your street? Call and ask.</p>
          <ul class="area-chips reveal">
            <li class="chip-home"><i class="ph ph-map-pin" aria-hidden="true"></i>{{ city }}, {{ state_abbr }}</li>
            {% for a in areas %}<li>{{ a }}</li>{% endfor %}
            {% if not areas %}<li class="placeholder">[Nearby city]</li><li class="placeholder">[Nearby city]</li><li class="placeholder">[Nearby city]</li>{% endif %}
          </ul>
        </div>
        <div class="map reveal">
          {% if loc.google_maps_embed_url %}
          <iframe title="Map of {{ biz.short_name }} service area around {{ city }}" src="{{ loc.google_maps_embed_url }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          {% else %}
          <div class="map-fallback">
            <i class="ph ph-map-trifold" aria-hidden="true"></i>
            <p>{{ city }}, {{ state }}</p>
          </div>
          {% endif %}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section faq" id="faq">
      <div class="container faq-inner">
        <h2 class="section-title reveal">Roofing questions from {{ city }} homeowners</h2>
        <div class="accordion">
          {% for f in faqs %}
          <details class="reveal">
            <summary>{{ f.q }}<i class="ph ph-plus" aria-hidden="true"></i></summary>
            <div class="answer"><p>{{ f.a }}</p></div>
          </details>
          {% endfor %}
        </div>
      </div>
    </section>

    <!-- Closing CTA -->
    <section class="cta-band">
      <div class="container cta-inner reveal">
        <h2>Need a roofer in {{ city }}?</h2>
        <div class="cta-actions">
          <a class="btn btn-accent" href="#estimate">Get an estimate<i class="ph ph-arrow-right" aria-hidden="true"></i></a>
          <a class="btn btn-outline-light" href="{{ tel }}"><i class="ph ph-phone" aria-hidden="true"></i>Call {{ phone }}</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-grid">
      <div class="footer-brand">
        <a class="brand" href="#top">
          {% if exists(biz.logo) %}<img class="brand-logo" src="{{ biz.logo }}" alt="" width="44" height="44" loading="lazy" >{% endif %}
          <span class="brand-name">{{ biz.short_name.split(" ", 1)[0] }}{% if " " in biz.short_name %}<span> {{ biz.short_name.split(" ", 1)[1] }}</span>{% endif %}</span>
        </a>
        <!-- NAP: keep identical to the Google Business Profile -->
        <address>
          <strong>{{ biz.name }}</strong><br>
          {% if has_address %}{{ loc.street }}<br>{{ city }}, {{ state_abbr }} {{ loc.zip }}{% else %}Serving {{ city }}, {{ state_abbr }} and nearby{% endif %}<br>
          <a href="{{ tel }}">{{ phone }}</a>{% if biz.email %}<br><a href="mailto:{{ biz.email }}">{{ biz.email }}</a>{% endif %}
        </address>
      </div>
      <div>
        <h3>Services</h3>
        <ul>{% for s in cfg.services %}<li><a href="#services">{{ s.name }}</a></li>{% endfor %}</ul>
      </div>
      <div>
        <h3>Service area</h3>
        <ul><li>{{ city }}, {{ state_abbr }}</li>{% for a in areas %}<li>{{ a }}</li>{% endfor %}</ul>
      </div>
      <div>
        <h3>Hours</h3>
        {% if hours %}
        <ul>{% for h in hours %}<li>{{ h.label }}<br><span class="muted">{{ h.opens }} to {{ h.closes }}</span></li>{% endfor %}</ul>
        {% else %}
        <p class="muted">[Business hours]</p>
        {% endif %}
        <div class="social">
          {% if cfg.social.facebook %}<a href="{{ cfg.social.facebook }}" target="_blank" rel="noopener" aria-label="Facebook"><i class="ph ph-facebook-logo" aria-hidden="true"></i></a>{% endif %}
          {% if cfg.social.instagram %}<a href="{{ cfg.social.instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><i class="ph ph-instagram-logo" aria-hidden="true"></i></a>{% endif %}
          {% if loc.google_business_profile_url %}<a href="{{ loc.google_business_profile_url }}" target="_blank" rel="noopener" aria-label="Google Business Profile"><i class="ph ph-google-logo" aria-hidden="true"></i></a>{% endif %}
        </div>
      </div>
    </div>
    <div class="container footer-base">
      <p>&copy; {{ year }} {{ biz.name }}{% if biz.license_number %}. License #{{ biz.license_number }}{% endif %}</p>
    </div>
  </footer>

  <!-- Mobile call bar -->
  <div class="mobile-bar">
    <a href="{{ tel }}" class="mb-call"><i class="ph ph-phone" aria-hidden="true"></i>Call</a>
    <a href="#estimate" class="mb-est">Get an estimate</a>
  </div>

  <script>window.SITE = {{ js_config|safe }};</script>
  <script src="main.js" defer></script>
</body>
</html>
